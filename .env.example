# Copiază acest fișier în .env (cp .env.example .env). Fișierul .env nu se pune niciodată în Git.

PORT=3000
DB_PATH=data/filme.db

# Folderul în care se salvează posterele încărcate (nu se pune în Git)
UPLOADS_DIR=uploads

# true doar când aplicația e servită prin HTTPS
COOKIE_SECURE=false

# Numărul de proxy-uri din fața aplicației (de ex. 1 în spatele unui server HTTPS). 0 local.
TRUST_PROXY=0

# Cât timp rămâne valabilă o sesiune, în ore
SESSION_TTL_HOURS=24

# Parolele conturilor demo create de `npm run seed` (sunt trecute și în README).
# Celelalte conturi demo primesc parole aleatorii la fiecare seed.
SEED_ADMIN_PASSWORD=Admin-Filme-2026!
SEED_USER_PASSWORD=Ana-Filme-2026!
