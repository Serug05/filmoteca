{
  "name": "challange-web-filme",
  "version": "0.1.0",
  "description": "Lista de filme: catalog public, recenzii și listă privată de vizionare",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "node scripts/setup.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
